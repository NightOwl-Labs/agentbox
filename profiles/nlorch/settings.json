{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clone:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(swift test:*)"
    ],
    "ask": [
      "Bash(gh pr close:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh release:*)",
      "Bash(gh api repos/*/actions/runs/*/pending_deployments:*)",
      "Bash(gh api:*)",
      "Edit",
      "Write",
      "WebFetch"
    ],
    "deny": [
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr merge * --admin:*)",
      "Bash(git push:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh auth token:*)",
      "Read(/Volumes/NightOwl-Share/**)"
    ]
  }
}
