{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(bws:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(gh auth token:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh pr merge * --admin:*)",
      "Read(~/.config/bws/**)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/agentbox/**)",
      "Edit(~/.zshrc)",
      "Edit(~/bin/**)"
    ]
  },
  "allowManagedHooksOnly": true
}
