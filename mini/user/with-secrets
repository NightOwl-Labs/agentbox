#!/bin/bash
# Runs a command with this profile's Bitwarden secrets as environment variables, so
# secrets never land in files or in an agent's chat.
# Usage: with-secrets "npm run test:integration"
set -euo pipefail
TOKEN_FILE="$HOME/.config/bws/token"
[[ -r "$TOKEN_FILE" ]] || { echo "No Bitwarden token for $(whoami). Re-run mini setup." >&2; exit 1; }
BWS_ACCESS_TOKEN="$(cat "$TOKEN_FILE")" exec /usr/local/bin/bws run -- "$*"
