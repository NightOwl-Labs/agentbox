# Example configuration for a new business. Copy over config.env and edit.
ORG_NAME="Acme Software"
ORG_DOMAIN="acme-software.dev"
ORG_PREFIX="ac"
GH_ORG="Acme-Software"

OWNER_EMAIL="founder@acme-software.dev"

WORKER_GH_LOGIN="founder-acme"
ORCH_GH_LOGIN="${ORG_PREFIX}orchestrator"

ORCH_AUTO_APPROVE="false"

WORKER_COUNT=2
POLL_SECONDS=60
AGENT_MAX_TURNS=60
AGENT_MAX_BUDGET_USD=5
TIME_MACHINE_VOLUME=""
BWS_VERSION="2.1.0"
