# agentbox configuration. Names only, never secrets.
#
# Everything in this repo is derived from the inputs in this file, so the same recipe
# can bootstrap any software business. To make it your own, copy config.example.env
# over this file and change the values. Every script reads this file through
# lib/config.sh, which also checks that the required values are set.

# ---------------------------------------------------------------------------
# Required inputs
# ---------------------------------------------------------------------------
ORG_NAME="Night Owl"            # Display name used in mail folders, git identities, labels
ORG_DOMAIN="nightowl-labs.dev"  # Mail and web domain. Must be verified in your mail tenant
ORG_PREFIX="nl"                 # 2 to 6 lowercase letters. Prefixes macOS accounts and hosts
GH_ORG="NightOwl-Labs"          # GitHub organization login

# The one real mailbox every role address lands in (a licensed Microsoft 365 user).
OWNER_EMAIL=""                  # REQUIRED: set before running prep/01-email-aliases.ps1

# GitHub accounts. The org owner is whoever runs the prep and cicd scripts.
WORKER_GH_LOGIN="matt-nightowl"         # Human owned work account; coding agents use its fine grained token
ORCH_GH_LOGIN="${ORG_PREFIX}orchestrator" # Dedicated machine user for the orchestrator

# ---------------------------------------------------------------------------
# Safety switches (humans flip these, never agents)
# ---------------------------------------------------------------------------
# Hard stop. While false, the orchestrator can review and comment on pull requests but
# cannot approve or merge them, and GitHub requires a human code owner review on every
# repo. Turning this on lets agent work merge to main and deploy billable
# infrastructure without a human. See docs/02-cicd-setup.md, "Turning on auto approve".
ORCH_AUTO_APPROVE="false"

# ---------------------------------------------------------------------------
# Optional tuning (sensible defaults)
# ---------------------------------------------------------------------------
WORKER_COUNT=2                  # Coding agent services on the Mac mini
POLL_SECONDS=60                 # How often agents check GitHub for work
AGENT_MAX_TURNS=60              # Per job ceiling for a headless Claude session
AGENT_MAX_BUDGET_USD=5          # Per job API spend ceiling
TIME_MACHINE_VOLUME=""          # Name of an APFS volume for Time Machine, or empty to skip
BWS_VERSION="2.1.0"             # Bitwarden Secrets Manager CLI, installed from the signed release
